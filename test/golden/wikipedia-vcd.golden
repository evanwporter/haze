ValueChangeDumpDefinitions
    { declarations =
        [ Date
            ( DateText "Date text. For example: November 11, 2009.
            " )
        , Version
            ( VersionText "VCD generator tool version info text.
            " )
        , Comment
            ( CommentText "Any comment text.
            " )
        , TimeScale T1 PicoSeconds
        , Scope Module
            ( ScopeIdentifier "logic" )
        , Var Wire
            ( Size 8 )
            ( IdentifierCode "#" )
            ( Identifier "data" )
        , Var Wire
            ( Size 1 )
            ( IdentifierCode "$" )
            ( Identifier "data_valid" )
        , Var Wire
            ( Size 1 )
            ( IdentifierCode "%" )
            ( Identifier "en" )
        , Var Wire
            ( Size 1 )
            ( IdentifierCode "&" )
            ( Identifier "rx_en" )
