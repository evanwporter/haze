            ( Size 1 )
            ( IdentifierCode "'" )
            ( Identifier "tx_en" )
        , Var Wire
            ( Size 1 )
            ( IdentifierCode "(" )
            ( Identifier "empty" )
        , Var Wire
            ( Size 1 )
            ( IdentifierCode ")" )
            ( Identifier "underrun" )
        , Upscope
        , EndDefinitions
        ]
    , simulations =
